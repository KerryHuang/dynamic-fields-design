{
  "skillOverrides": {
    "dotnet-test:writing-mstest-tests": "off",
    "dotnet-test:mtp-hot-reload": "off",
    "dotnet-test:code-testing": "off",
    "dotnet-test:code-testing-agent": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/scripts/sync-codex-mirror.mjs\" --root \"$CLAUDE_PROJECT_DIR\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/hardcode-reminder.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "dotnet-test@dotnet-agent-skills": true,
    "lifecycle@plugharbor": true
  },
  "extraKnownMarketplaces": {
    "dotnet-agent-skills": {
      "source": {
        "source": "github",
        "repo": "dotnet/skills"
      }
    },
    "plugharbor": {
      "source": {
        "source": "git",
        "url": "https://github.com/KerryHuang/plugharbor.git"
      }
    }
  }
}
