<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- 預設不跑 Benchmark；命令列的 filter 會覆蓋這個值（要跑就明確指定 filter） -->
    <VSTestTestCaseFilter>Category!=Benchmark</VSTestTestCaseFilter>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="FluentAssertions" Version="7.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DynamicModules.WebAPI\DynamicModules.WebAPI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 範本機制的測試資料（tests/Fixtures/templates）複製到輸出目錄的 templates/；產品本身沒有內建範本 -->
    <None Include="..\Fixtures\templates\*.json" Link="templates\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- 只在測試專案註冊的既有實體提供者（test.entity），ApplicationTests 與 WebAPITests 共用 -->
    <Compile Include="..\Fixtures\TestEntityProvider.cs" Link="TestSupport\TestEntityProvider.cs" />
    <!-- 已 migrate 的 SQLite 範本：每個測試行程建一次，各測試整份複製，省掉每測試的完整 migrate -->
    <Compile Include="..\Fixtures\MigratedDatabaseTemplate.cs" Link="TestSupport\MigratedDatabaseTemplate.cs" />
    <!-- 測試期寫入守衛（字串長度、DateTime Kind；PostgreSQL provider 設計 §5.4）：TestDb 與 TestApp 的 DbContext 都掛 -->
    <Compile Include="..\Fixtures\WriteGuardInterceptor.cs" Link="TestSupport\WriteGuardInterceptor.cs" />
    <!-- 測試資料庫切換（FORMWRIGHT_TEST_DB=postgres）、PostgreSQL 測試容器與樣板資料庫（PostgreSQL provider 設計 §6） -->
    <Compile Include="..\Fixtures\TestDatabase.cs" Link="TestSupport\TestDatabase.cs" />
    <Compile Include="..\Fixtures\TestPermits.cs" Link="TestSupport\TestPermits.cs" />
    <!-- 權限軸升級帶入的資料（PAX-01b、02、02b、02c、03），兩個測試專案共用 -->
    <Compile Include="..\Fixtures\PermissionAxesUpgradeData.cs" Link="TestSupport\PermissionAxesUpgradeData.cs" />
  </ItemGroup>

</Project>
