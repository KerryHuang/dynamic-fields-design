<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="FluentAssertions" Version="7.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <!-- xUnit 2.8 起預設的 conservative 平行演算法（票 #72、#70）：同時開跑的測試數＝平行執行緒數。2.5 的 aggressive 會把所有測試類別一次排進
         xUnit 同步內容的佇列，開跑初期建庫、起主機的同步等待占滿執行緒，已在跑的測試的續傳要排幾十秒（CI 實測 30 秒） -->
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DynamicModules.Domain\DynamicModules.Domain.csproj" />
  </ItemGroup>

</Project>
